sub.add_parser("stats", help="counts per thread").set_defaults(fn=cmd_stats)
rx = sub.add_parser("reindex", help="rebuild threads.json + INDEX.md from the "
                    "rows (safe any time)")
rx.add_argument("--repair", action="store_true",
                help="fill text an older parser missed and re-key gmail rows "
                     "filed under a message id (local only, no network)")
rx.add_argument("--prune", action="store_true",
                help="also DELETE rows the current rules reject; default only "
                     "counts them")
rx.set_defaults(fn=cmd_reindex)
bf = sub.add_parser("backfill", help="fetch text for sends whose words were "
                    "never on the command line (Gmail/Slack; read-only)")
bf.add_argument("--channel", choices=["gmail", "slack"],
                help="only this channel (default: both)")
bf.add_argument("--limit", type=int, default=25,
                help="how many sends to fetch, newest first (0 = no limit)")
bf.add_argument("--oldest-first", action="store_true",
                help="work through the oldest sends instead of the newest")
bf.add_argument("--apply", action="store_true",
                help="write the recovered text; default is a plan only")
bf.add_argument("--retry-failed", action="store_true",
                help="ask again about sends a previous run marked "
                     "unrecoverable")
bf.add_argument("--timeout", type=int, default=45,
                help="seconds per fetch (default 45; --limit 25 is the "
                     "worst-case multiplier)")
bf.set_defaults(fn=cmd_backfill)
sub.add_parser("doctor", help="check the verb map against each CLI's --help; "
               "run after any comms CLI update").set_defaults(fn=cmd_doctor)

def cmd_gmail_account(args):
    """add | list | rm for the ADDED Gmail accounts (gmail_accounts.py). The main login is
    never changed here."""
    if GA is None:
        print("gmail_accounts.py could not be imported: %s" %
              os.path.join(CORE, "gmail_accounts.py"), file=sys.stderr)
        return 2
    try:
        if args.action == "list":
            return GA.cmd_list()
        if not args.email:
            print("comms gmail-account %s needs an EMAIL" % args.action, file=sys.stderr)
            return 2
        if args.action == "add":
            return GA.cmd_add(args.email)
        return GA.cmd_rm(args.email, args.yes)
    except GA.AccountError as e:
        print("comms gmail-account: %s" % e, file=sys.stderr)
        return 2


ga = sub.add_parser("gmail-account", help="connect more Gmail accounts: add EMAIL | list | rm EMAIL --yes "
                    "(the main login is never touched)")
ga.add_argument("action", choices=["add", "list", "rm"])
ga.add_argument("email", nargs="?")
ga.add_argument("--yes", action="store_true", help="rm: really delete that account's folder")
ga.set_defaults(fn=cmd_gmail_account)


def cmd_selftest(_args):
    import selftest
    return selftest.main()


sub.add_parser("selftest", help="offline simulated readers and planted-bad-message checks; no sends"
               ).set_defaults(fn=cmd_selftest)

a = p.parse_args()
if not getattr(a, "fn", None):
    p.print_help()
    sys.exit(0)
sys.exit(a.fn(a) or 0)
