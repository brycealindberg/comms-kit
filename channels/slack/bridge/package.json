    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@sentry/node": "^10.43.0",
    "@slack/web-api": "^7.8.0",
    "express": "^4.21.0",
    "puppeteer": "^25.16.0"
  }
}
