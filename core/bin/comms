def _add_contact_parser():
    """`comms contact` lives in contactbook.py. A bad import there must never stop the archive
    commands, so it only loses this one subcommand."""
    try:
        import contactbook
    except BaseException as error:
        sys.stderr.write("comms: contact is unavailable: %s\n" % error)
        return
    contactbook.add_parser(sub, cmd_route)


_add_contact_parser()

sub.add_parser("routes", help="list contact -> project map").set_defaults(
    fn=cmd_routes)
sub.add_parser("unrouted", help="contacts with no project yet").set_defaults(
    fn=cmd_unrouted)
def cmd_project(a):
    """Every message for one project, all channels, chronological."""
    out = [r for r in all_rows(a) if r.get("project") == a.project]
    show(tail(out, a.last), None, a.full)


