# Port the bridge listens on
PORT=3101

# Admin secret for /admin/* routes (elevated privileges: token push, refresh).
# Required — sent via X-Admin-Secret header.
ADMIN_SECRET=

# Encryption key for AES-256 (32-byte hex string).
ENCRYPTION_KEY=32-byte-hex-string-for-aes-256

# Baseline API key required on every non-health route (sent via X-Api-Key header).
# REQUIRED — the bridge will refuse to start without it. Use a long random string
# (e.g. `openssl rand -hex 32`).
BRIDGE_API_KEY=

# Required for /files/:fileId/transcribe and /channels/:channelId/transcribe.
OPENAI_API_KEY=

# Optional: override the remote bridge URL used by `npm run pair`.
# When unset, pair.js defaults to https://<apps/vps/deploy.json server.hostname>/slack.
REMOTE_BRIDGE_URL=

# Optional local pairing browser overrides.
CHROME_EXECUTABLE_PATH=
SLACK_PAIRING_CHROME_USER_DATA_DIR=
